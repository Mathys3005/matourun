# Copy to .env for local development (never commit .env).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/matourun
DATABASE_SSL=false
JWT_SECRET=change-me-with-at-least-32-random-characters
# Only used to create the first (admin) account
SETUP_CODE=choose-a-setup-code
# When running the Vite dev server on :5173 in front of the API
APP_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional paid alternative, used only when GEMINI_API_KEY is empty
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Preferred: token from scripts/garmin-token.mjs
GARMIN_TOKENS=
# Fallback: password sign-in (often blocked from hosting providers)
GARMIN_EMAIL=
GARMIN_PASSWORD=
